index 000000000..0879e9c3f
--- /dev/null
+++ b/tests/movement-segment-probe.test.js
@@ -0,0 +1,11 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {movePath} from '../src/simulation/locomotion.js';
+
+test('opt-in movement probe records only executed segments and does not alter the path',()=>{
+ const actor={id:'a',x:0,z:0,path:[{x:1,z:0},{x:1,z:1},{x:2,z:1}]},reference=structuredClone(actor),events=[];
+ const clear=(_from,end)=>end.x<2;
+ const moved=movePath(actor,3,clear,(a,from,to)=>events.push({id:a.id,from,to})),expected=movePath(reference,3,clear);
+ assert.equal(moved,expected);assert.deepEqual(actor,reference);
+ assert.deepEqual(events,[{id:'a',from:{x:0,z:0},to:{x:1,z:0}},{id:'a',from:{x:1,z:0},to:{x:1,z:1}}]);
+});
