diff --git a/tests/confirmed-hud-delta.test.js b/tests/confirmed-hud-delta.test.js
index b6d0eb4bc..bfe8adaee 100644
--- a/tests/confirmed-hud-delta.test.js
+++ b/tests/confirmed-hud-delta.test.js
@@ -32,0 +33,18 @@ test('prepared HUD remains isolated from packet, returned view and committed res
+test('rejected prepared HUD leaves the accepted state isolated and retryable',()=>{
+ const state=newGame({seed:719}),encoder=createConfirmedHudDeltaEncoder(),decoder=createConfirmedHudDeltaDecoder({validate:(view,sequence)=>{if(sequence===2&&view.audio.workers[0].x===99)throw Error('rejected');}});
+ state.workers=[{id:'w',profile:'farmer',status:'idle',x:1,z:2}];decoder.prepare(encoder.encode(projectConfirmedHud(state,1))).commit();
+ state.workers[0].x=7;const packet=encoder.encode(projectConfirmedHud(state,2)),bad=structuredClone(packet);bad.collections.workers.upsert[0].x=99;
+ assert.throws(()=>decoder.prepare(bad),/rejected/);assert.equal(decoder.status().sequence,1);
+ const prepared=decoder.prepare(packet);packet.collections.workers.upsert[0].x=50;prepared.view.audio.workers[0].x=60;const committed=prepared.commit();assert.equal(committed.audio.workers[0].x,7);committed.audio.workers[0].x=80;
+ state.workers[0].x=8;assert.equal(decoder.prepare(encoder.encode(projectConfirmedHud(state,3))).commit().audio.workers[0].x,8);
+});
+
+test('a validator cannot mutate a prepared delta through a retained candidate reference',()=>{
+ const state=newGame({seed:720}),encoder=createConfirmedHudDeltaEncoder();let retained=null;
+ const decoder=createConfirmedHudDeltaDecoder({validate:(view,sequence)=>{if(sequence===2)retained=view;}});
+ state.workers=[{id:'w',profile:'farmer',status:'idle',x:1,z:2}];decoder.prepare(encoder.encode(projectConfirmedHud(state,1))).commit();
+ state.workers[0].x=7;const prepared=decoder.prepare(encoder.encode(projectConfirmedHud(state,2)));assert.ok(retained);retained.audio.workers[0].x=99;
+ assert.equal(prepared.view.audio.workers[0].x,7);assert.equal(prepared.commit().audio.workers[0].x,7);
+ state.time=4;assert.equal(decoder.decode(encoder.encode(projectConfirmedHud(state,3))).audio.workers[0].x,7);
+});
+
