+test('overdue bursts charge coordination and remain bounded by measured CPU tail',async()=>{
+ let time=1000,units=0;const scheduler=new GlobalFrameScheduler({now:()=>time,deadlineBurst:true});
+ scheduler.policy.cpu95=12;scheduler.lastPolicy=time;
+ const job=scheduler.submit((function*(){for(let i=0;i<30;i++){time+=.4;units++;yield;}})(),{key:'burst',deadline:0,estimate:()=>.4});
+ // Callback arrives late: there is no remaining refresh headroom.
+ scheduler.beginFrame(time-16);time+=4;await scheduler.endFrame();
+ assert.ok(units>1&&units<=6);assert.ok(time<=1006.67);
+ scheduler.cancel('burst');await job;
+});
+test('burst stops at elapsed guard and cannot borrow under mandatory CPU pressure',async()=>{
+ let time=1000,units=0;const scheduler=new GlobalFrameScheduler({now:()=>time,deadlineBurst:true});
+ const job=scheduler.submit((function*(){while(true){units++;time+=.4;yield;}})(),{key:'burst',deadline:0,estimate:()=>.4});
+ scheduler.beginFrame(time);time+=17;await scheduler.endFrame();assert.equal(units,0);
+ time+=30;scheduler.beginFrame(time-30);time+=4;await scheduler.endFrame();assert.equal(units,0);
+ scheduler.cancel('burst');await job;
+});
