+test('optional deadline batching admits multiple cheap units within cumulative debt, not a full extra frame',async()=>{
+ let time=1000,units=0;const scheduler=new GlobalFrameScheduler({now:()=>time,deadlineBatching:true});
+ const pending=scheduler.submit((function*(){for(let i=0;i<20;i++){units++;time+=.5;yield;}})(),{deadline:0,estimateMs:.5});
+ time+=8;scheduler.beginFrame(1000);time+=12;await scheduler.endFrame();
+ assert.equal(units,4);assert.equal(scheduler.snapshot().workMs,2);
+ for(const key of scheduler.jobs.keys())scheduler.cancel(key);await pending;
+});
+test('deadline batching preserves mandatory CPU and elapsed-time guards',async()=>{
+ for(const [cpu,late] of [[17,0],[4,40]]){
+  let time=1000,units=0;const scheduler=new GlobalFrameScheduler({now:()=>time,deadlineBatching:true});
+  const pending=scheduler.submit((function*(){units++;})(),{deadline:0});
+  time+=late;scheduler.beginFrame(1000);time+=cpu;await scheduler.endFrame();assert.equal(units,0);
+  for(const key of scheduler.jobs.keys())scheduler.cancel(key);await pending;
+ }
+});
