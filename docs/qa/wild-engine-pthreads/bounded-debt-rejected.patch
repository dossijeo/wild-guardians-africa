+test('tiny overdue continuations share bounded deadline debt without one frame per batch',async()=>{
+ let time=1000;const scheduler=new GlobalFrameScheduler({now:()=>time});let calls=0;
+ const work=async()=>{for(let i=0;i<30;i++)await scheduler.submit((function*(){calls++;time+=.2;return i;})(),{deadline:0,estimateMs:.2});};
+ const pending=work();scheduler.beginFrame(time-10);time+=8;await scheduler.endFrame();
