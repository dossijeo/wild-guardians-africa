 import {initializeProgramBindingsAsync} from '../src/rendering/program-bindings.js';
 test('cooperative binding reflection yields between real program operations and matches counters',async()=>{let time=0,yields=0,calls=0;const make=()=>({getUniforms(){time+=3;calls++;},getAttributes(){time+=2;calls++;}}),a=make(),b=make();const stats=await initializeProgramBindingsAsync({info:{programs:[a,a,b,{}]}},{now:()=>time,nextFrame:async()=>{yields++;},budgetMs:4});assert.deepEqual(stats,{initialized:2,unsupported:1});assert.equal(calls,4);assert.equal(yields,2);});
 test('cooperative reflection stops before touching programs after cancellation',async()=>{let stop=false,calls=0;const a={getUniforms(){calls++;},getAttributes(){calls++;}};await assert.rejects(initializeProgramBindingsAsync({info:{programs:[a,{...a}]}},{cancelled:()=>stop,budgetMs:0,nextFrame:async()=>{stop=true;}}),/cancelled/);assert.equal(calls,2);});
+
+test('global binding admission measures synchronous queries and uses one deadline without an extra frame',async()=>{
+ let time=0,calls=0;const jobs=[];
+ const program=()=>({getUniforms(){time+=2;calls++;},getAttributes(){time+=1;calls++;}});
+ const scheduler={submit(iterator,options){jobs.push(options);return Promise.resolve(iterator.next().value);}};
+ const result=await initializeProgramBindingsAsync({info:{programs:[program(),program()]}},{scheduler,now:()=>time,nextFrame:()=>assert.fail('extra frame')});
+ assert.equal(result.initialized,2);assert.equal(calls,4);assert.equal(jobs[0].deadline,jobs[1].deadline);assert.equal(jobs[1].estimate,undefined);
+});
+test('resource epoch changing while reflection is queued prevents queries',async()=>{
+ let epoch=0;const program={getUniforms:()=>assert.fail('stale query'),getAttributes:()=>{}};
+ const scheduler={submit(iterator){epoch++;return Promise.resolve().then(()=>iterator.next());}};
+ await assert.rejects(initializeProgramBindingsAsync({info:{programs:[program]}},{scheduler,getEpoch:()=>epoch}),/cancelled/);
+});
+test('disposed program is rejected before driver queries',async()=>{
+ await assert.rejects(initializeProgramBindingsAsync({info:{programs:[{program:null,getUniforms:()=>assert.fail('disposed query'),getAttributes:()=>{}}]}}),/disposed/);
+});
+
+test('one cold atomic outlier cannot poison admission of unrelated bindings; known warm bindings skip GL',async()=>{
+ let time=0,calls=0;const jobs=[];
+ const a={getUniforms(){time+=90;calls++;},getAttributes(){}},b={getUniforms(){calls++;},getAttributes(){}};
+ const renderer={info:{programs:[a,b]}},scheduler={submit(iterator,options){jobs.push(options);return Promise.resolve(iterator.next().value);}};
+ await initializeProgramBindingsAsync(renderer,{scheduler,now:()=>time});
+ assert.equal(jobs.length,2);assert.equal(jobs[1].estimate,undefined);
+ await initializeProgramBindingsAsync(renderer,{scheduler,now:()=>time});assert.equal(jobs.length,2);assert.equal(calls,2);
+});
