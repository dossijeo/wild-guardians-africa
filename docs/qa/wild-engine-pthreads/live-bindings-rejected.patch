 // Prepare one program per cooperative batch. Reflection is real synchronous GL
 // work, so the budget is checked after each program rather than disguising it.
-export async function initializeProgramBindingsAsync(renderer,{cancelled=()=>false,budgetMs=4,now=()=>performance.now(),nextFrame=()=>new Promise(resolve=>requestAnimationFrame(resolve))}={}){
+// Each cold program is a distinct one-shot operation: never transfer a driver
+// stall estimate to unrelated programs. Scheduler records actual overrun cost.
+// Warm programs known here need no further admission or GL queries.
+export async function initializeProgramBindingsAsync(renderer,{scheduler=null,signal,getEpoch=()=>0,cancelled=()=>false,budgetMs=4,now=()=>performance.now(),nextFrame=()=>new Promise(resolve=>requestAnimationFrame(resolve))}={}){
  const stats={initialized:0,unsupported:0};let start=now();
+ const epoch=getEpoch(),deadline=start+250,collection=renderer.info.programs;
+ const check=()=>{if(signal?.aborted||cancelled()||getEpoch()!==epoch||renderer.info.programs!==collection)throw Error('Loading program bindings cancelled');};
+
  for(const program of new Set(renderer.info.programs??[])){
-  if(cancelled())throw Error('Loading program bindings cancelled');
+  check();
   if(typeof program?.getUniforms!=='function'||typeof program?.getAttributes!=='function'){stats.unsupported++;continue;}
-  program.getUniforms();program.getAttributes();stats.initialized++;
-  if(now()-start>=budgetMs){await nextFrame();start=now();}
+  if(initializedBindings.has(program)){stats.initialized++;continue;}
+  const execute=()=>{
+   check();if('program' in program&&!program.program)throw Error('Loading program bindings disposed');
+   program.getUniforms();program.getAttributes();initializedBindings.add(program);stats.initialized++;
+  };
+  if(scheduler){await scheduler.submit((function*(){execute();})(),{signal,valid:()=>{check();return true;},deadline,priority:20,label:'program-bindings'});check();}
+  else {execute();if(now()-start>=budgetMs){await waitGpuFrame({signal,nextFrame,check});start=now();}}
  }
  return stats;
 }
