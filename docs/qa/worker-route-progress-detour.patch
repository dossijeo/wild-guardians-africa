+   mobileProgressDistance:10,mobileProgressAt:0,dynamicStallSeconds:0,
+   mobileProgressWaypoint:{x:0,z:10,distance:10}});
+ const blocker={id:'other-worker',x:0,z:2,radius:.28,status:'idle'};
