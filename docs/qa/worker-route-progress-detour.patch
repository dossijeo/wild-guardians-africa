+ assert.equal(worker.mobileRecoveryAttempts,0);
+ assert.equal(state.events.some(e=>e.type==='ActorMobileCollisionRecovery'),false);
+ assert.equal(worker.mobileProgressWaypoint.distance,9);
+ assert.equal(worker.mobileProgressAt,12.1);
+});
