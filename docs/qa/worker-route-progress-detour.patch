+ const {state,worker,nav}=fixture();state.raid=null;
+ const destination={id:'detour-goal',x:10,z:0};
+ Object.assign(worker,{id:'detouring-worker',x:0,z:1,status:'walking',radius:.28,
+   path:[{x:0,z:10},{x:10,z:10},{x:10,z:0}],destinationId:destination.id,
+   pathVersion:nav.version,mobileRecoveryDestinationId:destination.id,
