+      propRejects:profile.spatial_clear_profile_prop_rejects(),
+      barrierRejects:profile.spatial_clear_profile_barrier_rejects()},
     wallCount:game.structures.filter(piece=>piece.kind==='wall').length,
     workerCount:game.workers.length}));
 }finally{session.dispose();}
